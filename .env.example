# Production Environment Variables

# Application Environment
APP_ENV=production

# Database Configuration (Use DATABASE_URL on Render)
# DATABASE_URL will be auto-provided by Render when you connect the database
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://shop_user:password@postgres.render.com:5432/shop_db

# Alternative: Individual Database Variables (if not using DATABASE_URL)
# DB_HOST=postgres.render.com
# DB_PORT=5432
# DB_NAME=shop_db
# DB_USER=shop_user
# DB_PASSWORD=your_secure_password
# DB_TYPE=postgresql

# JWT Secret (Generate a secure random string)
# You can generate one using: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-replace-this-with-64-char-random-string

# Server Port (Render will set this automatically)
PORT=8080

# CORS Settings (Optional)
# ALLOWED_ORIGINS=https://your-frontend.com,https://www.your-frontend.com

# API Settings
API_VERSION=1.0.0

# Error Reporting (production should be false)
DISPLAY_ERRORS=false
ERROR_REPORTING=0
